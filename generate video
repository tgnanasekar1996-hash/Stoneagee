import os
from PIL import Image, ImageDraw, ImageFont
import cv2
import numpy as np

os.makedirs("output", exist_ok=True)
output_path = "output/the_first_flame.mp4"

# Video dimensions & frame parameters
width, height = 1280, 720
fps = 24
duration_per_scene = 3  # seconds
fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter(output_path, fourcc, fps, (width, height))

scenes = [
    "THE FIRST FLAME",
    "Scene 1: The Dark Forest",
    "Scene 2: Striking the Flint",
    "Scene 3: The First Spark"
]

for text in scenes:
    # Create black frame
    frame = np.zeros((height, width, 3), dtype=np.uint8)
    
    # Put text centered
    font = cv2.FONT_HERSHEY_SIMPLEX
    font_scale = 1.5
    thickness = 3
    text_size = cv2.getTextSize(text, font, font_scale, thickness)[0]
    
    text_x = (width - text_size[0]) // 2
    text_y = (height + text_size[1]) // 2
    
    cv2.putText(frame, text, (text_x, text_y), font, font_scale, (255, 255, 255), thickness, cv2.LINE_AA)
    
    # Write frames for scene duration
    for _ in range(fps * duration_per_scene):
        out.write(frame)

out.release()
print(f"Video created successfully at {output_path}")
